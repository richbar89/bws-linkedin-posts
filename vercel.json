{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "*.js",
          "*.json",
          "agents/**"
        ],
        "maxDuration": 800
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/pipeline",
      "schedule": "0 17 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bws-linkedin-posts.vercel.app"
        }
      ],
      "destination": "https://bws-workspace.vercel.app/#posts",
      "permanent": false
    },
    {
      "source": "/((?!api/).+)",
      "has": [
        {
          "type": "host",
          "value": "bws-linkedin-posts.vercel.app"
        }
      ],
      "destination": "https://bws-workspace.vercel.app/posts/$1",
      "permanent": false
    }
  ]
}